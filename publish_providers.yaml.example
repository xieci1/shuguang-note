platforms:
  xhs:
    enabled: true
    # 外部 CLI 会收到一个 payload.json 路径作为最后一个参数。
    # payload 中包含 account.profile_dir、post.title/body/tags/media、post.click_publish=true。
    command:
      - python
      - scripts/xhs_sau_wrapper.py
    # 登录命令可单独配置；未配置时复用 command。
    login_command:
      - python
      - scripts/xhs_sau_login.py
    working_dir: .
    env:
      # 如果 sau 不在 PATH 中，可在部署环境变量中设置 SAU_BIN=/absolute/path/to/sau。
      SAU_BIN: /opt/social-auto-upload/.venv/bin/sau
      SAU_ROOT: /opt/social-auto-upload
      # 设为 true 时允许执行器点击最终发布按钮；设为 false 时执行器应停在人工确认前。
      SHUGUANG_NOTE_ALLOW_DIRECT_PUBLISH: "true"
      # Docker 中使用远程浏览器桌面打开有头浏览器。
      DISPLAY: ":99"
      # social-auto-upload 的 CLI 需要能导入项目根目录下的 conf.py。
      PYTHONPATH: /opt/social-auto-upload
    timeout_seconds: 900
    startup_timeout_seconds: 2
